# Root npm scripts load this file from .env. Never commit actual secrets.
INSAUTO_API_KEY=local-dev-key
BACKEND_URL=http://127.0.0.1:8081
SERVER_PORT=8081
SERVER_ADDRESS=127.0.0.1

# OAuth: operator registers one Meta app per supported configuration.
# End users connect with the buttons on the website; do not ask users for tokens.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=
INSTAGRAM_GRAPH_VERSION=v26.0
# Use the SAME public HTTPS origin below. See docs/meta-setup.md.
PUBLIC_APP_URL=
FRONTEND_ORIGIN=
# At least 16 characters. Required before exposing this single-user workspace.
INSAUTO_SITE_PASSWORD=
# Base64 of 32 random bytes; keep stable across restarts to decrypt account tokens.
INSAUTO_TOKEN_ENCRYPTION_KEY=
